{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SynFlix",
  "version": "0.1.0",
  "identifier": "app.synflix.desktop",
  "build": {
    "beforeDevCommand": "yarn --cwd ../frontend start",
    "beforeBuildCommand": "yarn --cwd ../frontend build",
    "devUrl": "http://localhost:3000",
    "frontendDist": "../../frontend/build"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "SynFlix",
        "width": 1440,
        "height": 900,
        "minWidth": 960,
        "minHeight": 640,
        "center": true,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "SynFlix",
    "category": "Entertainment",
    "shortDescription": "SynFlix desktop streaming app",
    "longDescription": "A dedicated Windows desktop experience for SynFlix with native window controls, keyboard navigation, accessibility features and the full SynPlayer experience."
  }
}
