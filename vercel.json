{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/index.py": {
      "includeFiles": "public/**",
      "maxDuration": 30
    },
    "api/[...path].py": {
      "includeFiles": "backend/**",
      "maxDuration": 300
    }
  },
  "routes": [
    {
      "src": "^/api/?$",
      "dest": "/index.html"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "^/(demo|docs|privacy|terms|settings|roulette|my-list|search)/?$",
      "dest": "/index.html"
    },
    {
      "src": "^/(browse|title|person|watch|embed)(?:/.*)?$",
      "dest": "/index.html"
    }
  ]
}
