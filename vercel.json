{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/index.py": {
      "includeFiles": "public/**",
      "maxDuration": 30
    },
    "api/[...path].py": {
      "includeFiles": "backend/**",
      "maxDuration": 300
    }
  },
  "rewrites": [
    {
      "source": "/demo",
      "destination": "/index.html"
    },
    {
      "source": "/docs",
      "destination": "/index.html"
    },
    {
      "source": "/api",
      "destination": "/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/index.html"
    },
    {
      "source": "/terms",
      "destination": "/index.html"
    },
    {
      "source": "/settings",
      "destination": "/index.html"
    },
    {
      "source": "/roulette",
      "destination": "/index.html"
    },
    {
      "source": "/my-list",
      "destination": "/index.html"
    },
    {
      "source": "/search",
      "destination": "/index.html"
    },
    {
      "source": "/browse/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/title/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/person/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/watch/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/embed/:path*",
      "destination": "/index.html"
    }
  ]
}
